<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-10 offset-1">
        <h2><b>Book Your Stay</b></h2>
        <h3><%= listing.title %></h3>
        <form method="post" action="/<%= listing._id %>/bookings" novalidate class="needs-validation">
            <div class="row">
                <div class="ab-3 col-md-6">
                    <label for="checkIn" class="form-label">Check In</label>
                    <input id="checkIn" name="booking[checkIn]" type="date" class="form-control" required>
                    <div class="invalid-feedback">please enter valid date</div>
                </div>
                <div class="ab-3 col-md-6">
                    <label for="checkOut" class="form-label">Check Out</label>
                    <input id="checkOut" name="booking[checkOut]" type="date" class="form-control" required>
                    <div class="invalid-feedback">please enter valid date</div>
                </div>
            </div>
            <div class="ab-3">
                <label for="guests" class="form-label">Number of Guests</label>
                <input id="guests" name="booking[guests]" class="form-control" required>
                <div class="invalid-feedback">please enter valid input</div>
            </div>
            <div>
                <p id="totalPrice"> &#8377; <%= listing.price.toLocaleString("en-IN") %> for 1 night</p>
            </div>
            <button type="submit" class="btn btn-dark mt-3 mb-4">Book Now</button>
        </form>

    </div>

</div>